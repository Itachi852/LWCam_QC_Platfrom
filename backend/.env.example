APP_NAME=LWCam Python Backend
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
LOG_DIR=../logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lwcam
DB_USER=lwcam
DB_PASSWORD=lwcam

JWT_SECRET=lwcam-dev-secret-change-in-production-min-32-chars
JWT_EXPIRE_MINUTES=480
PREVIEW_CACHE_DIR=.cache/previews
QC_WORK_DIR=.cache/qc_work
QC_AUDIT_DIR=.cache/qc_audit

# 本地开发示例。也可使用映射盘或 \\server\share 形式的 NAS 路径。
EXPORT_TEMP_DIR=D:\LWCam\ExportTemp
EXPORT_OUTPUT_DIR=D:\LWCam\Export
# 支持 utf-8 / utf-8-sig 与 LF / CRLF；需由 ingest 方确认。
EXPORT_CSV_ENCODING=utf-8
EXPORT_CSV_LINE_ENDING=CRLF
EXPORT_TEMP_RETENTION_HOURS=24

# Upload is disabled unless this exact setting is explicitly changed to true.
# Keep it false for development, tests, and the first production deployment.
UPLOAD_ENABLED=false
UPLOAD_RECONCILE_SECONDS=300
UPLOAD_GATE_RETRY_SECONDS=2
UPLOAD_GATE_MAX_WAIT_SECONDS=60
UPLOAD_MAX_RETRIES=5
UPLOAD_CONNECT_TIMEOUT_SECONDS=10
UPLOAD_READ_TIMEOUT_SECONDS=300
UPLOAD_STABLE_SECONDS=2
UPLOAD_STOP_TIMEOUT_SECONDS=10

# No production endpoints or credentials are provided as defaults.
INGEST_API_BASE_URL=https://ingest-za.lifewood.dev/
INGEST_API_AUTHORIZATION=Basic 2FkZX**********
HFS_UPLOAD_URL=https://hfs-za.lifewood.dev/ScanImages
HFS_USERNAME=
HFS_PASSWORD=

INGEST_DB_HOST=localhost
INGEST_DB_PORT=3306
INGEST_DB_NAME=lwcam-test
INGEST_DB_USER=root
INGEST_DB_PASSWORD=852456

UPLOAD_SUCCESS_DIR=D:\LWCam\Export\Success
UPLOAD_FAILED_DIR=D:\LWCam\Export\Failed
UPLOAD_DUPLICATES_DIR=D:\LWCam\Export\Duplicates
UPLOAD_REPORT_DIR=D:\LWCam\Export\Reports
