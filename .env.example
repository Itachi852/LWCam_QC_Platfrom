APP_NAME=LWCam Python Backend
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
LOG_HOST_PATH=./logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10


# 运行在其他服务器时填写该服务器的 IP 或域名。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lwcam
DB_USER=lwcam
DB_PASSWORD=lwcam

JWT_SECRET=lwcam-dev-secret-change-in-production-min-32-chars
JWT_EXPIRE_MINUTES=480
PREVIEW_CACHE_DIR=.cache/previews
QC_WORK_DIR=.cache/qc_work
QC_AUDIT_DIR=.cache/qc_audit

# Docker: host directories mounted into the backend at /data/export-temp and
# /data/export. Do not set EXPORT_TEMP_DIR / EXPORT_OUTPUT_DIR to Windows paths
# when the backend runs in Docker.
EXPORT_TEMP_HOST_PATH=E:\LifeWodd\ExportTemp
EXPORT_OUTPUT_HOST_PATH=E:\LifeWodd\Export
# 首次正式导出前必须与下游 ingest 方确认这两个值。
EXPORT_CSV_ENCODING=utf-8
EXPORT_CSV_LINE_ENDING=CRLF
EXPORT_TEMP_RETENTION_HOURS=24

# Docker: the host prefix must exactly match the prefix stored in
# capture_folders.folder_path. Replace this example with the real NAS prefix.
CAPTURE_IMAGE_HOST_PATH=\\NAS01\LWCamProcessed
CAPTURE_IMAGE_CONTAINER_PATH=/data/shared-images

FRONTEND_PORT=5174
BACKEND_PORT=8080

