APP_NAME=LWCam Python Backend
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api


# 运行在其他服务器时填写该服务器的 IP 或域名。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lwcam
DB_USER=lwcam
DB_PASSWORD=lwcam

JWT_SECRET=lwcam-dev-secret-change-in-production-min-32-chars
JWT_EXPIRE_MINUTES=480
PREVIEW_CACHE_DIR=.cache/previews
QC_WORK_DIR=.cache/qc_work
QC_AUDIT_DIR=.cache/qc_audit

# Docker 部署时将采集目录挂载到数据库记录的容器路径。
CAPTURE_IMAGE_HOST_PATH=./shared-images
CAPTURE_IMAGE_CONTAINER_PATH=/data/shared-images

FRONTEND_PORT=5174
BACKEND_PORT=8080

